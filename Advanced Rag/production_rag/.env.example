# Copy this file to .env and fill it in. Never commit .env.

# Free key from Google AI Studio -> "Get API key"
GEMINI_API_KEY=

# Model that turns text into vectors (embeddings).
GEMINI_EMBED_MODEL=gemini-embedding-001

# Model that writes the final answer. Pick one that is on the free tier for your key.
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

# Qdrant running in Docker. Leave this line out to use a local folder instead (no Docker).
QDRANT_URL=http://localhost:6333

# Optional: pretend today is another date (YYYY-MM-DD) to see versions change status. Leave empty for the real date.
AS_OF_DATE=
